<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
    <linearGradient id="shine" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.15)"/>
      <stop offset="100%" stop-color="rgba(255,255,255,0)"/>
    </linearGradient>
  </defs>
  <!-- Rounded square background -->
  <rect width="512" height="512" rx="108" fill="url(#bg)"/>
  <!-- Subtle shine overlay -->
  <rect width="512" height="512" rx="108" fill="url(#shine)"/>
  <!-- Scale / balance icon (represents fee comparison) -->
  <!-- Center pillar -->
  <rect x="243" y="140" width="26" height="220" rx="13" fill="white" opacity="0.95"/>
  <!-- Base -->
  <rect x="180" y="340" width="152" height="26" rx="13" fill="white" opacity="0.95"/>
  <!-- Beam -->
  <rect x="128" y="168" width="256" height="20" rx="10" fill="white" opacity="0.95"/>
  <!-- Left pan -->
  <path d="M148 198 L108 290 Q108 320 148 320 Q188 320 188 290 Z" fill="white" opacity="0.85"/>
  <!-- Right pan -->
  <path d="M364 198 L324 290 Q324 320 364 320 Q404 320 404 290 Z" fill="white" opacity="0.85"/>
  <!-- Left strings -->
  <line x1="148" y1="178" x2="118" y2="270" stroke="white" stroke-width="6" opacity="0.7"/>
  <line x1="148" y1="178" x2="178" y2="270" stroke="white" stroke-width="6" opacity="0.7"/>
  <!-- Right strings -->
  <line x1="364" y1="178" x2="334" y2="270" stroke="white" stroke-width="6" opacity="0.7"/>
  <line x1="364" y1="178" x2="394" y2="270" stroke="white" stroke-width="6" opacity="0.7"/>
  <!-- Small triangle on top -->
  <polygon points="256,118 240,148 272,148" fill="white" opacity="0.95"/>
</svg>
